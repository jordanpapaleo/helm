{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "gray-matter": ["./node_modules/gray-matter"]
    }
  },
  "include": ["*.ts"],
  "exclude": ["*.test.ts", "dist"]
}
